{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/run-manifest/1.0.0",
  "title": "PROWL workflow run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_name",
    "workflow_type",
    "status",
    "created_at",
    "updated_at",
    "code",
    "environment",
    "resolved_config",
    "stages"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": {
      "type": "string",
      "pattern": "^run:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workflow_type": {
      "enum": ["imaging", "retrieval", "integration", "release"]
    },
    "status": {
      "enum": ["planned", "running", "completed", "failed", "cancelled"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "code": { "$ref": "#/$defs/codeIdentity" },
    "environment": { "$ref": "#/$defs/environmentIdentity" },
    "resolved_config": { "$ref": "#/$defs/configReference" },
    "source_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactReference" },
      "default": []
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stageRecord" }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativeUri": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!file:)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:\\/|$)).+"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "uri", "content_sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 3, "maxLength": 240 },
        "artifact_type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "schema_version": { "type": ["string", "null"] },
        "uri": { "$ref": "#/$defs/relativeUri" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "derivation_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "codeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "dirty", "entry_point", "component_version"],
      "properties": {
        "git_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dirty": { "type": "boolean" },
        "diff_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "entry_point": { "type": "string", "minLength": 1, "maxLength": 240 },
        "component_version": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "dependencies_sha256"],
      "properties": {
        "python": { "type": "string", "minLength": 1, "maxLength": 80 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 240 },
        "device": { "type": ["string", "null"], "maxLength": 120 },
        "dependencies_sha256": { "$ref": "#/$defs/sha256" },
        "environment_uri": {
          "oneOf": [
            { "$ref": "#/$defs/relativeUri" },
            { "type": "null" }
          ]
        }
      }
    },
    "configReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_sha256"],
      "properties": {
        "uri": { "$ref": "#/$defs/relativeUri" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stageError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_type", "message", "retryable"],
      "properties": {
        "error_type": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" },
        "details_uri": {
          "oneOf": [
            { "$ref": "#/$defs/relativeUri" },
            { "type": "null" }
          ]
        }
      }
    },
    "stageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "component_version",
        "status",
        "attempt",
        "relevant_config_sha256",
        "inputs",
        "outputs"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "component_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": {
          "enum": ["pending", "running", "completed", "failed", "skipped", "reused"]
        },
        "attempt": { "type": "integer", "minimum": 0 },
        "relevant_config_sha256": { "$ref": "#/$defs/sha256" },
        "derivation_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactReference" }
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/stageError" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
