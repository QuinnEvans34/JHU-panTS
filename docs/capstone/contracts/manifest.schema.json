{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/manifest/1.0.0",
  "title": "PROWL unified imaging manifest control record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "derivation_sha256",
    "created_at",
    "source_snapshot_ids",
    "record_schema_versions",
    "records",
    "build",
    "reconciliation",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "pattern": "^manifest:[a-z][a-z0-9_-]{1,63}:[0-9a-f]{12,64}$" },
    "derivation_sha256": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/snapshotId" }
    },
    "record_schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "study", "annotation", "issue"],
      "properties": {
        "subject": { "const": "1.0.0" },
        "study": { "const": "1.0.0" },
        "annotation": { "const": "1.0.0" },
        "issue": { "const": "1.0.0" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects", "studies", "annotations", "issues"],
      "properties": {
        "subjects": { "$ref": "#/$defs/collectionReference" },
        "studies": { "$ref": "#/$defs/collectionReference" },
        "annotations": { "$ref": "#/$defs/collectionReference" },
        "issues": { "$ref": "#/$defs/collectionReference" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "component_version", "config_sha256", "git_commit", "dirty"],
      "properties": {
        "run_id": { "$ref": "#/$defs/runId" },
        "component_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "git_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
        "dirty": { "type": "boolean" },
        "diff_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "reconciled", "eligible", "excluded", "quarantined", "blocking_issue_count"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "reconciled": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "blocking_issue_count": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "enum": ["complete", "quarantined"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": { "properties": { "reconciliation": { "properties": { "blocking_issue_count": { "const": 0 } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativeUri": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!file:)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:\\/|$)).+" },
    "snapshotId": { "type": "string", "pattern": "^snapshot:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{12,64}$" },
    "runId": { "type": "string", "pattern": "^run:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "collectionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_sha256", "bytes", "count"],
      "properties": {
        "uri": { "$ref": "#/$defs/relativeUri" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
