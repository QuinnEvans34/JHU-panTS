{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prowl.local/schemas/source-snapshot/1.0.0",
  "title": "PROWL imaging source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_snapshot_id",
    "source_key",
    "source_version",
    "retrieved_at",
    "license",
    "root_alias",
    "inventory",
    "status",
    "derivation_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^snapshot:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{12,64}$"
    },
    "source_key": { "$ref": "#/$defs/sourceKey" },
    "source_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_status", "release", "archive_version", "commit"],
      "properties": {
        "version_status": { "enum": ["known", "partially_known", "unknown"] },
        "release": { "type": ["string", "null"], "maxLength": 160 },
        "archive_version": { "type": ["string", "null"], "maxLength": 160 },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" }
      }
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_uri", "restrictions", "citation_required"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_uri": { "type": "string", "format": "uri" },
        "restrictions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["noncommercial", "attribution", "redistribution_limited", "source_terms_apply", "none_recorded"] }
        },
        "citation_required": { "type": "boolean" }
      }
    },
    "root_alias": { "$ref": "#/$defs/rootAlias" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_sha256", "file_count", "assurance"],
      "properties": {
        "uri": { "$ref": "#/$defs/relativeUri" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 0 },
        "assurance": {
          "enum": ["publisher_sha256", "full_local_sha256", "selected_local_sha256", "metadata_only", "unverified"]
        }
      }
    },
    "status": { "enum": ["complete", "partial", "quarantined"] },
    "derivation_sha256": { "$ref": "#/$defs/sha256" },
    "notes": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
    "rootAlias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "relativeUri": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!file:)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:\\/|$)).+"
    }
  }
}
