{
  "name": "pants-niivue-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static-first React + NiiVue 3D viewer for PanTS pancreas/lesion CADe (docs/ui.md).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:fixture": "vite --config tests/fixture.vite.config.js --host 127.0.0.1"
  },
  "dependencies": {
    "@niivue/niivue": "^0.69.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "30.1.0",
    "vite": "^5.4.8",
    "vitest": "3.2.7"
  }
}
